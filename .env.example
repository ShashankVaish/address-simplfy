# Copy to backend/.env and fill in. Never commit the filled version.

# "aws" uses Bedrock, OpenSearch Serverless, DynamoDB and Location Service.
# "local" swaps every one of those for an offline equivalent -- this single
# variable is the whole Build It fallback (see ARCHITECTURE section 13).
PROVIDER=aws

AWS_REGION=ap-south-1

# Populated from the SAM stack outputs after `sam deploy`.
TABLE_NAME=patasetu
BUCKET_NAME=
OPENSEARCH_ENDPOINT=
LANDMARK_INDEX=landmarks
EVENT_BUS=patasetu

# Bedrock model ids. The cascade runs cheap-first and only escalates.
MODEL_CHEAP=amazon.nova-lite-v1:0
MODEL_STRONG=claude-opus-5
MODEL_EMBEDDING=amazon.titan-embed-text-v2:0

# Decision thresholds. CONF_RESOLVED_AT is a placeholder until Day 3 fits the
# calibration and picks the value that meets PRECISION_TARGET -- do not tune it
# by hand in between.
CONF_RESOLVED_AT=0.80
PRECISION_TARGET=0.95
CONF_OVERWRITE_AT=0.95
AMBIGUOUS_SPREAD_M=500
AMBIGUOUS_SCORE_DELTA=0.05

# Retrieval
RRF_K=60
GEO_RADIUS_M=3000

CACHE_TTL_DAYS=90
LOG_LEVEL=INFO
